# Database Connection Settings
# Customize your PostgreSQL username, password, host, port, and database name below.
# Default template: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/keyword_scraper

# JWT Authentication Signature Secret Key
# Generate a secure key, e.g. using 'openssl rand -hex 32'
JWT_SECRET=replace_with_a_secure_random_key_here

# Extraction Quality Thresholds
KS_MIN_EXTRACTED_SIZE=200
KS_MIN_RETENTION_RATIO=0.95

# Crawl performance tuning
# Minimum seconds between consecutive requests to the same domain (default: 1.0)
KS_DOMAIN_RATE_LIMIT=1.0

# Maximum candidate URLs to queue per keyword per job (default: 500)
KS_MAX_CANDIDATE_URLS=500

# Concurrency & Worker Tuning
# Maximum concurrent keywords to process in parallel per job (default: 4)
KS_MAX_KEYWORD_WORKERS=4

# Maximum crawler workers for fast engine (requests) (default: 25)
KS_FAST_WORKERS=25

# Maximum crawler workers for lightpanda engine (default: 10)
KS_LIGHTPANDA_WORKERS=10

# Maximum crawler workers for selenium / dynamic engine (default: 4)
KS_SELENIUM_WORKERS=4

# ── Tor Anonymous Routing ────────────────────────────────────────────────────
# The "Route through Tor" toggle in Advanced Settings routes all traffic through
# the local Tor SOCKS5 proxy. The proxy address is hardcoded to 127.0.0.1:9050.
# No configuration is needed here — just ensure Tor is running before enabling.
#
# Linux setup:
#   sudo apt install tor && sudo systemctl start tor
#
# Windows / Mac setup:
#   Download and open Tor Browser from https://www.torproject.org
#   It automatically starts a SOCKS5 proxy on 127.0.0.1:9050
#
# KS_TOR_PORT=9050   ← informational only, not read by the app
